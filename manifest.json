{"manifest_version":3,"name":"YouTube Music Volume Control","version":"2.0","description":"Control de volumen para YouTube Music","permissions":["activeTab","scripting","tabs"],"host_permissions":["https://music.youtube.com/*","<all_urls>"],"background": {"scripts": ["background.js"],"service_worker": "background.js"},"content_scripts":[{"matches":["https://music.youtube.com/*"],"js":["content.js"]},{"matches":["<all_urls>"],"js":["notification.js"]}],"commands":{"volume-up":{"suggested_key":{"default":"Ctrl+Shift+Up"},"description":"Subir volumen"},"volume-down":{"suggested_key":{"default":"Ctrl+Shift+Down"},"description":"Bajar volumen"}}}
